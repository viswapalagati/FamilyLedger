# Copy this file to .env and fill in real values. Never commit .env.

DJANGO_SECRET_KEY="replace-with-a-long-random-secret-key"
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Local development: use MySQL 8.4 with Django 6.1, or install the pinned
# Django 5.2.17 dependencies in requirements.txt for MySQL 8.0 compatibility.
DATABASE_URL="mysql://familyledger:your_password@127.0.0.1:3306/family_ledger"

# Email — leave EMAIL_HOST blank to use the console backend in dev.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=FamilyLedger <no-reply@familyledger.local>

SITE_BASE_URL=http://localhost:8000
TIME_ZONE=Asia/Kolkata
DEFAULT_FINANCIAL_YEAR_START_MONTH=4
